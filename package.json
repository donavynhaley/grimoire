{
  "name": "grimoire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "start": "node --enable-source-maps server-dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --format=esm --packages=external --platform=node --sourcemap --outfile=server-dist/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.4",
    "esbuild": "~0.28.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.5",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
