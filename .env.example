# Address and port used by the collaborative HTTP server.
HOST=127.0.0.1
PORT=8080

# Port used by both the server and Vite's development proxy.
GRIMOIRE_API_PORT=8080

# Persistent SQLite database location.
GRIMOIRE_DATABASE=data/grimoire.sqlite

# Canonical Markdown project directory.
# This can point into another repository if that repository should own the work and ideas.
# Where project directories live. The path is a storage location you choose, so it keeps its
# existing value on upgrade; only the variable name changed. GRIMOIRE_CARDS_DIRECTORY is still
# honoured for installs that already set it.
GRIMOIRE_PAGES_DIRECTORY=data/cards

# Set this when a reverse proxy, tunnel, or load balancer sits in front of Grimoire and writes
# X-Forwarded-For. It decides who a failed sign-in is counted against: left unset behind a proxy,
# every visitor shares one allowance and the first person to mistype their password slows down
# the whole team; set without a proxy, the limit is free to step around by claiming an address.
GRIMOIRE_TRUST_PROXY=

# Single sign-on, through any OpenID Connect provider - Authentik, Keycloak, Authelia, Pocket ID,
# Entra, Google.
#
# You do not have to set any of this. Sign in as the admin and open Settings -> Sign-in: paste your
# provider's address, press check, and the rest is read from the provider. See docs/single-sign-on.md.
#
# Set these only if you would rather your deployment describe itself in a file. Anything set here
# wins, and the settings screen becomes read-only so the two can never disagree.
# Register https://your-grimoire/api/auth/oidc/callback with the provider either way.
GRIMOIRE_OIDC_ISSUER=
GRIMOIRE_OIDC_CLIENT_ID=
GRIMOIRE_OIDC_CLIENT_SECRET=

# What the sign-in button calls your provider. Defaults to the issuer's hostname.
GRIMOIRE_OIDC_LABEL=

# Optional. Set only when the address Grimoire is reached at is not the address it is asked for,
# which is where the derived redirect URI stops matching what the provider has registered.
GRIMOIRE_OIDC_REDIRECT_URI=

# Optional. Defaults to "openid email profile".
GRIMOIRE_OIDC_SCOPES=

# Whether somebody your provider vouches for gets an account without an invitation. Defaults to
# true: a team that has pointed Grimoire at their own provider has already said who is allowed in.
# Set it false to keep Grimoire invitation-only, where the provider signs in accounts that exist
# and an invitation link is what makes a new one.
GRIMOIRE_OIDC_AUTO_REGISTER=

# Who may sign in at all, separated by spaces or commas. An entry with an @ names one person; an
# entry without names a domain and covers its subdomains. Empty means anyone your provider vouches
# for. Fill this in whenever that provider is not only your team: pointed at Google, "anyone with an
# account there" is not who you meant, and a personal account's domain is gmail.com - so list
# addresses there rather than a domain.
GRIMOIRE_OIDC_ALLOWED_EMAIL_DOMAINS=

# Which project a new account joins, by id or slug. Defaults to the oldest project.
GRIMOIRE_OIDC_SIGNUP_PROJECT=

# Required only by compose.production.yaml on the deployment VM.
# Create a dedicated remotely managed Cloudflare Tunnel and keep its token out of Git.
TUNNEL_TOKEN=
