{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    // .gitignore already lists the build output, the local instance data and the
    // demo stack, so it is the one list of "not ours" rather than a second one here.
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Not gitignored, and holds worktrees measured in gigabytes.
      "!.claude",
      "!.lavish",
      "!package-lock.json",
      // A standalone hand-written page kept exactly as it was reviewed.
      "!docs/mobile-pass.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Carried over from the Prettier config this replaces, so adopting Biome did not
    // silently reflow every file to a different width.
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    // TOOL-2: off means "we do not intend to satisfy this, here is why"; warn means
    // "real work somebody has to schedule", counted in every CI run; only what the
    // codebase actually holds to is left blocking.
    "rules": {
      "preset": "recommended",
      "style": {
        // 557 uses across 74 files, concentrated in the server routes and the tests.
        // That is the house idiom for "the schema already proved this is there", not
        // a finding, and turning it on would be a rewrite wearing a lint config.
        "noNonNullAssertion": "off",
        // Off, and this one is a judgement worth arguing with. All 23 findings were read.
        // The rule compares any two selectors ending in the same simple selector, so most
        // of them pair genuinely unrelated elements - `.board-page p` against
        // `.capture-picker > div > p`, which can never match the same node - and it
        // compares across @media boundaries as well. The rest are a base rule sitting
        // after a variant that already contextualised it, which is inherent to a
        // stylesheet organised by feature section: `.member-faces` styles its avatars
        // before the avatar section defines one. Specificity, not source order, already
        // decides every one of these, so nothing renders differently either way, and the
        // reordering that would satisfy the rule scatters related rules apart in a 7k-line
        // file that no test watches. Revisit if the sheet is ever reorganised base-first.
        "noDescendingSpecificity": "off"
      },
      "correctness": {
        // All 34 findings were read one at a time and every one was deliberate: a
        // trigger dependency the effect does not read, a mount-only effect taking its
        // state as a seed, or a narrow property named instead of an identity that
        // changes every render. Each carries a biome-ignore saying which. Blocking now,
        // so the next one is the accident this rule is actually good at catching.
        "useExhaustiveDependencies": "error",
        // Clear, and blocking so they stay clear. The unused ones are worth catching for
        // more than tidiness: what they found here was a whole dead close-a-chapter path
        // left behind when rollover moved server-side.
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error"
      },
      "complexity": {
        "useOptionalChain": "error",
        // Both remaining uses are load-bearing and carry their reason: the drag cursor,
        // and the 1rem that stops iOS Safari zooming a focused input. A third one should
        // have to argue for itself.
        "noImportantStyles": "error"
      },
      "suspicious": {
        // TS-2 already forbids `any` outright, so this is the standard finally having a
        // gate rather than a sentence.
        "noExplicitAny": "error"
      },
      // All 46 findings were read against docs/ui-standards.md. 20 were real and are
      // fixed - chiefly 17 aria-labels that were doing nothing at all, because ARIA
      // ignores a name on a generic element. The rest carry a biome-ignore saying why
      // the rule does not apply. Everything blocks now except the one below.
      "a11y": {
        "noAriaHiddenOnFocusable": "error",
        "noAutofocus": "error",
        "noNoninteractiveElementToInteractiveRole": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useAriaPropsForRole": "error",
        "useAriaPropsSupportedByRole": "error",
        "useFocusableInteractive": "error",
        // Off. Its one suggestion here is <fieldset> in place of a div carrying
        // role="group", and that trade is wrong twice over: a fieldset groups form
        // controls and takes its name from a <legend>, where these are clusters of
        // filter buttons and a properties rail named by aria-label; and it arrives
        // with browser chrome the stylesheet would then have to undo. div + role
        // is what CapturePicker, FieldsSection and PageDialog already used before
        // any of this, so the rule is arguing with the house pattern, not a lapse.
        "useSemanticElements": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
